# Enterprise Agent Platform — example environment configuration.
# Copy to `.env` and adjust. All variables use the EAP_ prefix.

# development | staging | production | test
EAP_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
EAP_LOG_LEVEL=INFO

# Enable verbose framework behaviour. Never enable in production.
EAP_DEBUG=false

# Model backend: fake | demo | anthropic | bedrock.
# `fake` is offline only — every model call raises. `demo` is the scripted stand-in
# that drives the shipped demo without an API key. Both are rejected in production.
EAP_LLM_PROVIDER=fake

# Model ID. Bedrock IDs carry an `anthropic.` prefix, e.g. anthropic.claude-opus-5
EAP_LLM_MODEL=claude-opus-5

# Deadline for a single model call, in seconds.
EAP_LLM_TIMEOUT_SECONDS=30

# Credentials for EAP_LLM_PROVIDER=anthropic. Leave unset to use the SDK's own
# resolution (ANTHROPIC_API_KEY or an `ant auth login` profile). Never commit a key.
# EAP_ANTHROPIC_API_KEY=

# Region for EAP_LLM_PROVIDER=bedrock; credentials come from the AWS chain.
EAP_AWS_REGION=us-east-1

# Model calls allowed in one agent run. Bounds cost and runaway tool loops.
EAP_AGENT_MAX_STEPS=8

# Output token budget for a single agent step.
EAP_AGENT_MAX_TOKENS=1024

# Highest tool risk an agent may run unattended: read | write | critical.
# Anything above it pauses the task for human approval.
EAP_AGENT_AUTO_APPROVE_UP_TO=read

# Register the synthetic accounts-payable demo tools (lookup_invoice,
# list_overdue_invoices, add_invoice_note, pay_invoice) so the platform can be run
# end to end with no key and no network. Rejected in production.
EAP_DEMO_TOOLS=false

# MCP servers whose tools the agent may call, as a JSON list. Empty by default:
# the platform ships with no capabilities of its own.
#
# `default_risk` and `tool_risk` are this deployment's classification of the
# server's tools, and the only input to the approval decision — a server's own
# metadata (annotations, hints, titles) is never read for it. A tool with no
# mapping is CRITICAL, so a tool that appears on the server later is gated
# rather than waved through.
#
# EAP_MCP_SERVERS=[{"name":"finance","command":"python","args":["-m","finance_mcp"],"env":{"FINANCE_API_URL":"https://example.invalid"},"default_risk":"read","tool_risk":{"pay_invoice":"critical"}}]

# Task persistence: memory | postgres.
# `memory` is per-process and lost on restart — including the checkpoint a
# paused run resumes from — so it is rejected in production.
EAP_TASK_STORE=memory

# Required for EAP_TASK_STORE=postgres. Never commit real credentials.
# EAP_DATABASE_URL=postgresql://eap:eap@localhost:5432/eap

# Connection pool bounds per process. Replicas multiply max_size against the
# server's own connection limit.
EAP_DATABASE_POOL_MIN_SIZE=1
EAP_DATABASE_POOL_MAX_SIZE=10

# Deadline for a single statement, so a blocked write fails instead of hanging.
EAP_DATABASE_COMMAND_TIMEOUT_SECONDS=10

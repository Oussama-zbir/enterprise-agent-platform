# Enterprise Agent Platform — example environment configuration.
# Copy to `.env` and adjust. All variables use the EAP_ prefix.

# development | staging | production | test
EAP_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
EAP_LOG_LEVEL=INFO

# Enable verbose framework behaviour. Never enable in production.
EAP_DEBUG=false

# Model backend: fake | anthropic | bedrock.
# `fake` is offline only — every model call raises — and is rejected in production.
EAP_LLM_PROVIDER=fake

# Model ID. Bedrock IDs carry an `anthropic.` prefix, e.g. anthropic.claude-opus-5
EAP_LLM_MODEL=claude-opus-5

# Deadline for a single model call, in seconds.
EAP_LLM_TIMEOUT_SECONDS=30

# Credentials for EAP_LLM_PROVIDER=anthropic. Leave unset to use the SDK's own
# resolution (ANTHROPIC_API_KEY or an `ant auth login` profile). Never commit a key.
# EAP_ANTHROPIC_API_KEY=

# Region for EAP_LLM_PROVIDER=bedrock; credentials come from the AWS chain.
EAP_AWS_REGION=us-east-1
